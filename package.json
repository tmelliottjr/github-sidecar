{
  "name": "github-sidecar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GitHub Sidecar — an omni-present, draggable sidebar for the GitHub issues and pull requests you care about",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run clean && npm run build:pages && npm run build:content",
    "build:pages": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "test": "node --test \"tests/*.test.ts\"",
    "test:unit": "node --test tests/api.test.ts"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.33.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/chrome": "^0.0.328",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "oxlint": "^1.8.0",
    "postcss": "^8.5.6",
    "puppeteer-core": "^25.5.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
